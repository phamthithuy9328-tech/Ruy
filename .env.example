# ===== AmGo Travel – environment variables =====
# Copy to .env (local) or set in your host's dashboard. Never commit real values.

# --- Core ---
DATABASE_URL="file:./dev.db"                 # Production: postgresql://user:pass@host:5432/amgo (and set provider = "postgresql" in prisma/schema.prisma)
NEXT_PUBLIC_SITE_URL="https://amgotravel.com"
SESSION_SECRET=""                            # Required in production: 32+ random chars (openssl rand -hex 32)
CRON_SECRET=""                               # Protects /api/cron (openssl rand -hex 24)
ADMIN_SESSION_IDLE_MINUTES=60
SEED_ADMIN_EMAIL="admin@amgotravel.com"      # Used only by `npm run db:seed`
SEED_ADMIN_PASSWORD=""

# --- Business details (shown in header, footer, policies, schema.org) ---
NEXT_PUBLIC_HOTLINE="+84 900 000 000"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/84900000000"
NEXT_PUBLIC_ZALO_URL="https://zalo.me/0900000000"
NEXT_PUBLIC_MESSENGER_URL="https://m.me/amgotravel"
NEXT_PUBLIC_CONTACT_EMAIL="booking@amgotravel.com"
NEXT_PUBLIC_ADDRESS=""
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_BUSINESS_LICENSE=""              # Business registration number
NEXT_PUBLIC_TRAVEL_LICENSE=""                # International tour operator licence number
BANK_TRANSFER_DETAILS="Bank name\nAccount name\nAccount number · SWIFT code"

# --- OnePay ---
ONEPAY_MODE="mock"                           # mock (built-in simulator) | sandbox | production
ONEPAY_DOMESTIC_MERCHANT_ID=""               # Domestic ATM cards + VietQR, charged in VND
ONEPAY_DOMESTIC_ACCESS_CODE=""
ONEPAY_DOMESTIC_HASH_KEY=""
ONEPAY_INTL_MERCHANT_ID=""                   # Visa / Mastercard / JCB / Amex
ONEPAY_INTL_ACCESS_CODE=""
ONEPAY_INTL_HASH_KEY=""
ONEPAY_INTL_CURRENCY="USD"                   # Set to VND if your OnePay contract can't settle USD
BANK_TRANSFER_CURRENCY="VND"
BOOKING_HOLD_MINUTES=30                      # Seats held while the customer is paying online

# --- Exchange rates ---
FX_API_URL="https://open.er-api.com/v6/latest/USD"   # Any API returning { rates: { VND: …, EUR: … } } with USD base

# --- Customer messages (without keys, messages are only logged in Admin › Audit log) ---
RESEND_API_KEY=""
EMAIL_FROM="AmGo Travel <booking@amgotravel.com>"
WHATSAPP_TOKEN=""                            # Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
ZALO_ZNS_ACCESS_TOKEN=""                     # Zalo ZNS, Vietnamese customers
ZALO_ZNS_TEMPLATES='{"booking_confirmation_chat":"","payment_reminder":""}'
ESMS_API_KEY=""                              # SMS fallback (eSMS.vn)
ESMS_SECRET_KEY=""
ESMS_BRANDNAME=""
REVIEW_URL=""                                # e.g. your Google review link; defaults to the tour's reviews

# --- Anti-spam ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""            # Cloudflare Turnstile (both keys, or neither)
TURNSTILE_SECRET_KEY=""

# --- Analytics (loaded only after cookie consent) ---
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
GOOGLE_SITE_VERIFICATION=""
